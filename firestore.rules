rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/notebooks/java {
      function validNotebook() {
        let data = request.resource.data;
        return data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
          && data.payload is string && data.payload.size() <= 900000
          && data.revision is int && data.updatedAt == request.time;
      }
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validNotebook() && request.resource.data.revision == 1;
      allow update: if owner(uid) && validNotebook()
        && request.resource.data.revision == resource.data.revision + 1;
    }

    match /users/{uid}/javaQuestionComments/{commentId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['questionId', 'text', 'authorName', 'createdAt'])
        && request.resource.data.questionId is string
        && request.resource.data.questionId.matches('q[0-9]{3}|custom-[A-Za-z0-9_-]{1,100}')
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
